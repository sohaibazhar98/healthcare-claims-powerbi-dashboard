/// Fact table: one row per adjudicated medical or pharmacy claim (fictional data).
table Claims
	lineageTag: b5fcad81-fc38-5bc7-8c85-0796b984e60a

	column 'Claim ID'
		dataType: string
		lineageTag: a191d813-4619-5feb-8016-58aa9aec77d6
		summarizeBy: none
		sourceColumn: Claim ID

		annotation SummarizationSetBy = Automatic

	column 'Member ID'
		dataType: string
		isHidden
		lineageTag: dfe46d2f-890c-56e5-a5f4-44bda49b3fec
		summarizeBy: none
		sourceColumn: Member ID

		annotation SummarizationSetBy = Automatic

	column 'Group ID'
		dataType: string
		isHidden
		lineageTag: 46c0477f-465c-59ba-9804-ee79b1f2f516
		summarizeBy: none
		sourceColumn: Group ID

		annotation SummarizationSetBy = Automatic

	column 'Plan ID'
		dataType: string
		isHidden
		lineageTag: 2a3fc779-060a-5f60-98e7-7deb6fe2b8ab
