	column 'Days to Pay'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 17a9bc51-58f0-598f-a47f-3ffb6e4dcbc4
		summarizeBy: none
		sourceColumn: Days to Pay

		annotation SummarizationSetBy = Automatic

	partition Claims = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "claims.csv"),
				        [Delimiter = ",", Columns = 15, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlanksToNull = Table.ReplaceValue(PromotedHeaders, "", null, Replacer.ReplaceValue, {"PaidDate", "DenialReason"}),
				    ChangedType = Table.TransformColumnTypes(
				        BlanksToNull,
				        {
				            {"ClaimID", type text}, {"MemberID", type text}, {"GroupID", type text},
				            {"PlanID", type text}, {"ProviderID", type text},
				            {"ServiceDate", type date}, {"PaidDate", type date},
				            {"ClaimType", type text}, {"DiagnosisCategory", type text},
				            {"ClaimStatus", type text}, {"DenialReason", type text},
				            {"BilledAmount", Currency.Type}, {"AllowedAmount", Currency.Type},
				            {"MemberCostShare", Currency.Type}, {"PaidAmount", Currency.Type}
				        },
				        "en-US"
				    ),
				    AddedDaysToPay = Table.AddColumn(
				        ChangedType, "DaysToPay",
				        each if [PaidDate] = null then null else Duration.Days([PaidDate] - [ServiceDate]),
				        Int64.Type
				    ),
				    Renamed = Table.RenameColumns(
				        AddedDaysToPay,
				        {
				            {"ClaimID", "Claim ID"}, {"MemberID", "Member ID"}, {"GroupID", "Group ID"},
				            {"PlanID", "Plan ID"}, {"ProviderID", "Provider ID"},
				            {"ServiceDate", "Service Date"}, {"PaidDate", "Paid Date"},
				            {"ClaimType", "Claim Type"}, {"DiagnosisCategory", "Diagnosis Category"},
				            {"ClaimStatus", "Claim Status"}, {"DenialReason", "Denial Reason"},
				            {"BilledAmount", "Billed Amount"}, {"AllowedAmount", "Allowed Amount"},
				            {"MemberCostShare", "Member Cost Share"}, {"PaidAmount", "Paid Amount"},
				            {"DaysToPay", "Days to Pay"}
				        }
				    )
				in
				    Renamed

	annotation PBI_ResultType = Table
