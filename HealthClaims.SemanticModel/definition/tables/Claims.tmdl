	column 'Billed Amount'
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 66df1f9b-5f48-5556-ad0c-4ae38c658e59
		summarizeBy: sum
