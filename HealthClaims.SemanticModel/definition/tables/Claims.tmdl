	column 'Member Cost Share'
		dataType: decimal
		isHidden
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0e0fde16-3534-5aeb-8a7b-744c9502f4bb
		summarizeBy: sum
